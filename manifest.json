{
  "manifest_version": 3,
  "name": "Privacy Browser Agent",
  "version": "1.0",
  "description": "A privacy-preserving AI browser extension.",

  "permissions": [
    "activeTab"
  ],

  "action": {
    "default_popup": "popup.html"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],

  "web_accessible_resources": [
    {
      "resources": [
        "dist/*.mjs",
        "dist/assets/*",
        "dist/onnxruntime/*"
      ],
      "matches": ["<all_urls>"]
    }
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}